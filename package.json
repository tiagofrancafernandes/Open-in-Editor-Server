{
    "type": "module",
    "scripts": {
        "start": "bash ./start.sh --env development",
        "start:prod": "bash ./start.sh ecosystem.prod.cjs --env production",
        "dev": "bash ./start.sh --env development",
        "dev:watch": "bash ./start.sh --watch --env development",
        "dev:node": "node open-in-editor-server.js",
        "serve:node": "node open-in-editor-server.js",
        "stop": "bash ./start.sh stop all",
        "stop:open-in-editor-server": "bash ./start.sh stop open-in-editor-server",
        "restart": "bash ./start.sh restart all",
        "restart:open-in-editor-server": "bash ./start.sh restart open-in-editor-server",
        "logs": "pm2 logs open-in-editor-server",
        "status": "pm2 status",
        "up": "npm run start",
        "pm2:startup": "bash ./start.sh startup systemd -u $(whoami) --hp $(pwd) && npm run pm2:save",
        "pm2:save": "bash ./start.sh save",
        "pm2:unstartup": "bash ./start.sh unstartup",
        "prettier": "prettier --config ./.prettierrc --write ."
    },
    "devDependencies": {
        "prettier": "^3.8.4"
    },
    "dependencies": {
        "pm2": "^7.0.1"
    }
}
